# ---------------------------------------------------------------------------
# IPOBazar backend environment example.
# Copy this file to `.env`, fill in real values, and NEVER commit `.env`.
#
# Every setting is namespaced with `IPOBAZAR_` so it can never be overridden
# by an unrelated ambient environment variable (see ADR-0010).
# ---------------------------------------------------------------------------

IPOBAZAR_APP_NAME=IPOBazar API
IPOBAZAR_APP_ENV=development

# REST API version prefix used by routers
IPOBAZAR_API_V1_PREFIX=/api/v1

# Secret used to sign auth tokens. Replace with a long random value.
IPOBAZAR_SECRET_KEY=change-me-local-dev-secret

# PostgreSQL connection string (SQLAlchemy + psycopg driver format).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
IPOBAZAR_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/IPOBazar

# Comma-separated list of allowed CORS origins (`*` allows all, dev only).
IPOBAZAR_CORS_ORIGINS=*
